# ViLATECH AI — preferred: Xavani (same stack as vilatech-ai), then OpenRouter, then Anthropic
XAVANI_BASE_URL=
XAVANI_API_KEY=
XAVANI_MODEL=omera

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_CHAT_MODEL=

# Anthropic — fallback for vision skin analysis if OpenRouter unset
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI — legacy optional (not used by default chat)
OPENAI_API_KEY=

# Store
NEXT_PUBLIC_STORE_NAME=Lorraine Beauté
NEXT_PUBLIC_STORE_URL=https://lorraine-beauty-store.vercel.app
APP_ORIGIN=https://lorraine-beauty-store.vercel.app

# K-Dropshipping — product sync (when API credentials are provided)
K_DROPSHIPPING_API_URL=
K_DROPSHIPPING_API_KEY=
K_DROPSHIPPING_STORE_ID=
K_DROPSHIPPING_PRODUCTS_PATH=/products
K_DROPSHIPPING_ORDERS_PATH=/orders
K_DROPSHIPPING_WEBHOOK_SECRET=
K_DROPSHIPPING_SYNC_SECRET=

KD_CATALOG_URL=
